{
  "buildCommand": "cd ../.. && turbo build --filter=@product-studio/smart-site --cache-dir=.turbo",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "ignoreCommand": "npx turbo-ignore",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "master": true,
      "staging": true
    }
  }
}