{
  "name": "smart-site",
  "version": "1.0.0",
  "description": "Smart Site starter built with Product Studio - Payload CMS, Next.js, GSAP, and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "node scripts/generate-sitemap-index.js",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "npm install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "reinstall": "rm -rf node_modules && rm package-lock.json && npm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "type-check": "tsc --noEmit",
    "seed": "curl -X POST \"http://localhost:3000/api/seed\" -H \"Content-Type: application/json\" -d '{}'",
    "regenerate-uris": "curl -X GET \"http://localhost:3000/api/regenerate-uris\"",
    "db:schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "db:reset": "pnpm db:schema && pnpm seed",
    "dev:fresh": "pnpm db:reset && pnpm dev",
    "test:phase1": "pnpm test phase-1-validation",
    "test:phase2": "pnpm seed && pnpm test phase-2-modifications",
    "test:uri": "pnpm seed && pnpm test:phase1 && pnpm test:phase2",
    "test:ui": "NO_BUILD=true USE_DEV=true playwright test --config=tests/e2e/playwright.config.ts",
    "test:prod": "playwright test --config=tests/e2e/playwright.config.ts",
    "mongo:start": "export PATH=\"$HOME/mongodb/bin:$PATH\" && mongod --dbpath ~/mongodb/data --logpath ~/mongodb/mongodb.log --fork",
    "mongo:stop": "pkill mongod || echo 'MongoDB is not running'",
    "mongo:status": "ps aux | grep mongod | grep -v grep || echo 'MongoDB is not running'",
    "kill": "npx kill-port 3000"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.23",
    "@assistant-ui/react": "^0.10.25",
    "@assistant-ui/react-ai-sdk": "^0.10.14",
    "@assistant-ui/react-markdown": "^0.10.6",
    "@gsap/react": "latest",
    "@libsql/client": "^0.15.9",
    "@mastra/client-js": "^0.10.16",
    "@next/third-parties": "^15.3.0",
    "@payloadcms/admin-bar": "latest",
    "@payloadcms/db-mongodb": "latest",
    "@payloadcms/db-postgres": "^3.47.0",
    "@payloadcms/db-vercel-postgres": "^3.45.0",
    "@payloadcms/email-resend": "latest",
    "@payloadcms/live-preview-react": "latest",
    "@payloadcms/next": "latest",
    "@payloadcms/plugin-form-builder": "latest",
    "@payloadcms/plugin-nested-docs": "latest",
    "@payloadcms/plugin-redirects": "latest",
    "@payloadcms/plugin-search": "latest",
    "@payloadcms/plugin-seo": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "@payloadcms/storage-vercel-blob": "latest",
    "@payloadcms/translations": "latest",
    "@payloadcms/ui": "latest",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/lodash.merge": "^4.6.9",
    "@types/three": "^0.177.0",
    "ai": "^4.3.19",
    "class-variance-authority": "^0.7.1",
