{
  "name": "smart-site",
  "version": "3.0.1",
  "description": "Standalone website-building kit: Next.js, Payload CMS, native MCP and portable coding-agent skills.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap-smartsite.mjs",
    "build": "pnpm run generate:sitemap && cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=7168' next build",
    "doctor": "node scripts/doctor-smartsite.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "docker:build": "docker compose --env-file .smartsite-self-hosted/generated/production.env build",
    "docker:build-prebuilt-release": "./docker/build-prebuilt-release.sh",
    "docker:prepare": "docker compose --env-file .smartsite-self-hosted/generated/production.env up -d mongo",
    "docker:compile": "docker compose --env-file .smartsite-self-hosted/generated/production.env run --rm build",
    "docker:start": "docker compose --env-file .smartsite-self-hosted/generated/production.env up -d proxy",
    "docker:up": "docker compose --env-file .smartsite-self-hosted/generated/production.env up -d proxy",
    "docker:down": "docker compose --env-file .smartsite-self-hosted/generated/production.env down",
    "self-hosted:deploy": "./docker/deploy-self-hosted.sh",
    "self-hosted:deploy-prebuilt": "./docker/deploy-prebuilt-self-hosted.sh",
    "self-hosted:data-pull": "node scripts/run-self-hosted-data-pull.mjs",
    "self-hosted:backup": "./docker/backup-self-hosted.sh",
    "self-hosted:dump": "./docker/create-mongo-archive.sh",
    "self-hosted:history": "./docker/history-self-hosted.sh",
    "self-hosted:probe": "./docker/probe-self-hosted.sh",
    "self-hosted:rollback": "./docker/rollback-self-hosted.sh",
    "self-hosted:restore": "./docker/restore-mongo-archive.sh",
    "self-hosted:install-backup-cron": "./docker/install-backup-cron.sh",
    "self-hosted:status": "./docker/status-self-hosted.sh",
    "self-hosted:init": "node scripts/init-self-hosted-config.mjs",
    "self-hosted:migrate": "node scripts/run-self-hosted-migrate.mjs",
    "self-hosted:prepare": "node scripts/materialize-self-hosted-env.mjs",
    "self-hosted:run": "node scripts/run-self-hosted-action.mjs",
    "generate:sitemap": "tsx scripts/generate-sitemap-index.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/admin/payload/payload.config.ts payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "self-hosted:env": "node scripts/generate-self-hosted-env.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "type-check": "tsc --noEmit",
    "regenerate-uris": "curl -X POST \"http://localhost:3000/api/regenerate-uris\" -H \"Origin: http://localhost:3000\"",
    "db:schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "local:start": "node scripts/local/start.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "test:build": "node tests/fixtures/build-project.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node tests/integration/run.mjs",
    "test:transfer": "node tests/transfer/run.mjs",
    "test:acceptance": "node tests/acceptance/run.mjs",
    "test:startup": "node tests/fixtures/bootstrap-resume.mjs",
    "test:docker-upgrade": "node tests/fixtures/docker-upgrade.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "16.3.3",
