{
  "name": "smart-site",
  "version": "2.3.1",
  "description": "Enterprise website builder: Next.js 16 + Payload CMS 3 with Tailwind v4, GSAP animations, and Mastra-powered AI — section-first architecture with smart routing/caching.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "pnpm run generate:sitemap && cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=7168' next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:sitemap": "tsx scripts/generate-sitemap-index.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "reinstall": "rm -rf node_modules && rm package-lock.json && npm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "type-check": "tsc --noEmit",
    "seed": "pnpm run seed:minimal",
    "seed:minimal": "curl -X POST \"http://localhost:3000/api/seed\" -H \"Content-Type: application/json\" -d '{\"profile\":\"minimal\"}'",
    "regenerate-uris": "curl -X POST \"http://localhost:3000/api/regenerate-uris\" -H \"Origin: http://localhost:3000\"",
    "db:schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "kill": "npx kill-port 3000",
    "ii": "npm install"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.23",
