# IF USING MONGODB (delete other)
DATABASE_PROVIDER=mongoose
DATABASE_URL=mongodb://localhost:27017/{database-name}

# Optional staging overrides
# STAGING_DATABASE_URL=mongodb://localhost:27017/{staging-database-name}
# SMARTSITE_DATABASE_TARGET=staging

# IF USING POSTGRES
# DATABASE_PROVIDER=postgres
# DATABASE_URL="postgres://..."

# PAYLOAD
PAYLOAD_SECRET= # create any random secret string
PREVIEW_SECRET= # create any short nanoid string
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
RESEND_API_KEY=re_...

# PAYLOAD CONFIG
PAYLOAD_CONFIG_PATH=./src/admin/payload/payload.config.ts
NEXT_PUBLIC_URL=http://localhost:3000

# ADMIN USER
PAYLOAD_ADMIN_EMAIL="user@example.com"
PAYLOAD_ADMIN_PASSWORD= # create a strong password and it will be added during seeding

# AI REGISTRATION
SMARTSITE_AI_REGISTRATION_SECRET=changeme-register

# AI AGENT CONFIGURATION (Auto-generated by seeding)
# These will be automatically populated when you run the seed command
# The API key is used to authenticate with the Smart Site AI backend
SMARTSITE_SITE_NAME=
AI_AGENT_API_KEY=
AI_AGENT_USER_ID=
