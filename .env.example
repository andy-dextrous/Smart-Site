# First local startup: the agent runs the documented bootstrap; do not copy this
# placeholder over its generated private .env. This example is for explicit hosting.
DATABASE_PROVIDER=mongoose
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"
PAYLOAD_SECRET="REPLACE_WITH_RANDOM_SECRET"
PREVIEW_SECRET="REPLACE_WITH_RANDOM_SECRET"
SMARTSITE_SITE_ID="REPLACE_WITH_DESTINATION_UUID"
SMARTSITE_ENVIRONMENT="production"
NEXT_PUBLIC_URL="https://YOUR_DOMAIN"
# Configure storage in src/smartsite.config.ts before supplying its credentials.
# Configure a real email adapter before enabling outbound mail.
