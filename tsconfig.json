{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/admin/payload/payload.config.ts"],
      "@payload-types": ["./src/admin/payload/types"],
      "@smartsite-config": ["src/smartsite.config.ts"],
      "@public/*": ["./public/*"],
      "@public": ["./public"]
    },
    "target": "ES2022",
    "types": ["react/jsx-runtime", "node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "tests",
    "src/admin/payload/endpoints/seed/**/*",
    "src/admin/payload/endpoints/seed"
  ]
}
